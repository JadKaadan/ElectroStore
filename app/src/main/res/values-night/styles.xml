<?xml version="1.0" encoding="utf-8"?>

<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="android:textColorHint">@color/ink_faint</item>
    </style>

    <style name="AppTheme.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>

    <style name="SheetDialog" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>
</resources>
