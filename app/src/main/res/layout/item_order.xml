<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/row_click"
    android:elevation="1dp" android:layout_marginBottom="10dp" android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/receipt"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:textStyle="bold" android:textColor="@color/pink" />
        <TextView android:id="@+id/status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/pill_amber" android:paddingStart="10dp"
            android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/amber" />
    </LinearLayout>

    <TextView android:id="@+id/customer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="6dp" android:textSize="17sp" android:textStyle="bold"
        android:textColor="@color/ink" android:singleLine="true" android:ellipsize="end" />

    <TextView android:id="@+id/detail"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="2dp" android:textSize="13sp" android:textColor="@color/ink_faint" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingTop="8dp">
        <TextView android:id="@+id/total"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="19sp"
            android:textStyle="bold" android:textColor="@color/ink" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/open_receipt" android:textSize="13sp"
            android:textStyle="bold" android:textColor="@color/pink" />
        <ImageView android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/ic_chevron" android:alpha="0.4"
            android:layout_marginStart="4dp" />
    </LinearLayout>
</LinearLayout>
