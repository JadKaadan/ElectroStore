<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/row_click" android:elevation="1dp"
    android:layout_marginBottom="10dp" android:padding="14dp">

    <LinearLayout android:layout_width="52dp" android:layout_height="52dp"
        android:background="@drawable/pill_cyan" android:orientation="vertical"
        android:gravity="center">
        <TextView android:id="@+id/dayNum"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="19sp" android:textStyle="bold" android:textColor="@color/cyan" />
        <TextView android:id="@+id/monTxt"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="@color/cyan" />
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:paddingStart="14dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/dateTxt"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" />
        <TextView android:id="@+id/detail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="@color/ink_faint" android:paddingTop="2dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/amountUsd"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/green" />
        <TextView android:id="@+id/amountLbp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/ink_faint" />
    </LinearLayout>

    <ImageView android:layout_width="18dp" android:layout_height="18dp"
        android:layout_marginStart="8dp" android:src="@drawable/ic_chevron"
        android:alpha="0.35" />
</LinearLayout>
