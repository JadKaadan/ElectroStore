<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_field" android:layout_margin="14dp"
        android:paddingStart="14dp" android:paddingEnd="14dp">
        <ImageView android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_search" />
        <EditText android:id="@+id/search"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
            android:background="@null" android:hint="@string/search_dots" android:paddingStart="10dp"
            android:singleLine="true" android:textSize="17sp" android:textColor="@color/ink" />
    </LinearLayout>
    <ListView android:id="@+id/list"
        android:layout_width="match_parent" android:layout_height="380dp"
        android:divider="@color/line" android:dividerHeight="1dp" />
</LinearLayout>
