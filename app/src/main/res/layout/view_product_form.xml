<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/pill_amber" android:padding="12dp"
            android:textSize="14sp" android:textColor="#FF8A5A00"
            android:text="@string/form_hint" />


        <TextView style="@style/Label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="18dp" android:text="@string/lbl_photo" />

        <FrameLayout android:id="@+id/photoBox"
            android:layout_width="match_parent" android:layout_height="190dp"
            android:background="@drawable/bg_photo_dash">
            <ImageView android:id="@+id/photo"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:clipToOutline="true"
                android:visibility="gone" />
            <LinearLayout android:id="@+id/photoHint"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:orientation="vertical"
                android:gravity="center">
                <ImageView android:layout_width="40dp" android:layout_height="40dp"
                    android:src="@drawable/ic_camera" android:alpha="0.32" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/no_photo" android:paddingTop="8dp"
                    android:textSize="14sp" android:textColor="@color/ink_faint" />
            </LinearLayout>
            <ImageView android:id="@+id/photoRemove" android:tint="@color/white"
                android:layout_width="36dp" android:layout_height="36dp"
                android:layout_gravity="top|end" android:layout_margin="8dp"
                android:padding="9dp" android:background="@drawable/circle_scrim"
                android:src="@drawable/ic_close" android:visibility="gone" />
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="10dp">
            <Button android:id="@+id/btnCamera" style="@style/BigButton"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="52dp" android:background="@drawable/btn_brand"
                android:text="@string/take_photo" />
            <Space android:layout_width="10dp" android:layout_height="1dp" />
            <Button android:id="@+id/btnGallery" style="@style/BigButton"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="52dp" android:background="@drawable/btn_outline"
                android:textColor="@color/ink" android:text="@string/from_gallery" />
        </LinearLayout>


        <TextView style="@style/Label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="20dp"
            android:text="@string/lbl_name" />
        <EditText android:id="@+id/fName" style="@style/Field"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/hint_name" android:inputType="textCapWords"
            android:singleLine="true" />


        <TextView style="@style/Label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="16dp"
            android:text="@string/lbl_category" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <AutoCompleteTextView android:id="@+id/fCategory" style="@style/Field"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:hint="@string/hint_category" android:inputType="textCapWords"
                android:singleLine="true" android:completionThreshold="0" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <Button android:id="@+id/btnAddCategory" style="@style/BigButton"
                android:layout_width="wrap_content" android:layout_height="52dp"
                android:background="@drawable/btn_outline" android:textColor="@color/brand"
                android:text="@string/add_category_short" android:minWidth="0dp"
                android:paddingStart="14dp" android:paddingEnd="14dp" />
        </LinearLayout>


        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingTop="22dp">
            <TextView style="@style/Label" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/lbl_typing_in" />
            <TextView android:id="@+id/curUsd"
                android:layout_width="wrap_content" android:layout_height="40dp"
                android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp"
                android:background="@drawable/chip_on" android:text="$"
                android:textStyle="bold" android:textSize="16sp" android:textColor="@color/white" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <TextView android:id="@+id/curLbp"
                android:layout_width="wrap_content" android:layout_height="40dp"
                android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:background="@drawable/chip" android:text="@string/lbp_suffix"
                android:textStyle="bold" android:textSize="15sp" android:textColor="@color/ink_soft" />
        </LinearLayout>


        <TextView style="@style/Label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="12dp"
            android:text="@string/lbl_unit_price" />
        <EditText android:id="@+id/fUnit" style="@style/Field"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="0" android:inputType="numberDecimal" android:singleLine="true" />
        <TextView android:id="@+id/echoUnit" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="5dp"
            android:paddingStart="6dp" android:textSize="13sp" android:textColor="@color/ink_faint" />


        <TextView style="@style/Label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="14dp"
            android:text="@string/lbl_cost_price" />
        <EditText android:id="@+id/fCost" style="@style/Field"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="0" android:inputType="numberDecimal" android:singleLine="true" />
        <TextView android:id="@+id/echoCost" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="5dp"
            android:paddingStart="6dp" android:textSize="13sp" android:textColor="@color/ink_faint" />

        <TextView android:id="@+id/profitHint"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/pill_green" android:padding="12dp"
            android:layout_marginTop="14dp" android:textSize="15sp"
            android:textStyle="bold" android:textColor="@color/green"
            android:visibility="gone" />


        <TextView style="@style/Label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="20dp"
            android:text="@string/lbl_quantity" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/qtyMinus"
                android:layout_width="58dp" android:layout_height="58dp"
                android:background="@drawable/btn_outline" android:padding="17dp"
                android:src="@drawable/ic_minus" />
            <EditText android:id="@+id/fQty" style="@style/Field"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="58dp" android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp" android:hint="0" android:gravity="center"
                android:textSize="20sp" android:textStyle="bold"
                android:inputType="number" android:singleLine="true" />
            <ImageView android:id="@+id/qtyPlus"
                android:layout_width="58dp" android:layout_height="58dp"
                android:background="@drawable/btn_outline" android:padding="17dp"
                android:src="@drawable/ic_plus" />
        </LinearLayout>


        <TextView style="@style/Label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="18dp" android:text="@string/lbl_color" />
        <AutoCompleteTextView android:id="@+id/fColor" style="@style/Field"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/hint_color" android:inputType="textCapWords"
            android:singleLine="true" android:completionThreshold="1" />


        <TextView style="@style/Label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="16dp"
            android:text="@string/lbl_description" />
        <EditText android:id="@+id/fDesc" style="@style/Field"
            android:layout_width="match_parent" android:layout_height="120dp"
            android:hint="@string/hint_description"
            android:gravity="top|start" android:paddingTop="14dp" android:paddingBottom="14dp"
            android:inputType="textMultiLine|textCapSentences" />

        <Button android:id="@+id/btnSave" style="@style/BigButton"
            android:layout_marginTop="22dp" android:background="@drawable/btn_green"
            android:text="@string/save_product" />

        <Button android:id="@+id/btnDelete" style="@style/BigButton"
            android:layout_marginTop="10dp" android:background="@drawable/btn_outline"
            android:textColor="@color/red" android:text="@string/delete_product"
            android:visibility="gone" />

        <Space android:layout_width="match_parent" android:layout_height="26dp" />
    </LinearLayout>
</ScrollView>
