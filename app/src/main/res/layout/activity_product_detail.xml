<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout android:layout_width="match_parent" android:layout_height="280dp">
                <ImageView android:id="@+id/photo"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/hdr_brand" android:scaleType="centerCrop" />
                <View android:layout_width="match_parent" android:layout_height="90dp"
                    android:layout_gravity="bottom" android:background="#66000000" />


                <View android:layout_width="match_parent" android:layout_height="104dp"
                    android:layout_gravity="top" android:background="@drawable/scrim_top" />

                <ImageView android:id="@+id/back" android:tint="@color/white"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_margin="14dp" android:padding="10dp"
                    android:background="@drawable/circle_scrim" android:src="@drawable/ic_back" />
                <ImageView android:id="@+id/edit" android:tint="@color/white"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_gravity="top|end" android:layout_margin="14dp"
                    android:padding="11dp" android:background="@drawable/circle_scrim"
                    android:src="@drawable/ic_edit" />
                <TextView android:id="@+id/idBadge"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start" android:layout_margin="18dp"
                    android:background="@drawable/pill_scrim" android:paddingStart="12dp"
                    android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textStyle="bold" android:textColor="@color/white" />
            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_sheet"
                android:layout_marginTop="-22dp" android:padding="20dp">

                <TextView android:id="@+id/name"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="26sp" android:textStyle="bold" android:textColor="@color/ink" />

                <LinearLayout android:id="@+id/tagRow"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="8dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_card"
                    android:elevation="1dp" android:padding="18dp" android:layout_marginTop="18dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/lbl_unit_price" android:textSize="12sp"
                        android:textStyle="bold" android:textColor="@color/ink_faint" />
                    <TextView android:id="@+id/unitUsd"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="32sp" android:textStyle="bold" android:textColor="@color/brand" />
                    <TextView android:id="@+id/unitLbp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="15sp" android:textColor="@color/ink_soft" />

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/line" android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp" />


                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/lbl_wholesale_short" android:textSize="11sp"
                                android:textStyle="bold" android:textColor="@color/ink_faint" />
                            <TextView android:id="@+id/retailUsd"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="20sp" android:textStyle="bold" android:textColor="@color/orange" />
                            <TextView android:id="@+id/retailLbp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="12sp" android:textColor="@color/ink_faint" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/stock_paid" android:textSize="11sp"
                                android:textStyle="bold" android:textColor="@color/ink_faint" />
                            <TextView android:id="@+id/stockPaidUsd"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="20sp" android:textStyle="bold" android:textColor="@color/ink" />
                            <TextView android:id="@+id/stockPaidLbp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="12sp" android:textColor="@color/ink_faint" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView android:id="@+id/profit"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:background="@drawable/pill_green" android:padding="12dp"
                        android:layout_marginTop="16dp" android:textSize="15sp"
                        android:textStyle="bold" android:textColor="@color/green" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:background="@drawable/bg_card"
                    android:elevation="1dp" android:padding="18dp" android:layout_marginTop="12dp"
                    android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/available_in_stock" android:textSize="12sp"
                            android:textStyle="bold" android:textColor="@color/ink_faint" />
                        <TextView android:id="@+id/qty"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="30sp" android:textStyle="bold" android:textColor="@color/ink" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/descBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_card"
                    android:elevation="1dp" android:padding="18dp" android:layout_marginTop="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/lbl_description" android:textSize="12sp"
                        android:textStyle="bold" android:textColor="@color/ink_faint" />
                    <TextView android:id="@+id/desc"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingTop="6dp" android:textSize="16sp"
                        android:textColor="@color/ink" android:lineSpacingExtra="3dp" />
                </LinearLayout>

                <Space android:layout_width="match_parent" android:layout_height="14dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/card"
        android:elevation="8dp" android:padding="14dp">
        <Button android:id="@+id/btnDelete" style="@style/BigButton"
            android:layout_width="0dp" android:layout_weight="1"
            android:background="@drawable/btn_outline" android:textColor="@color/red"
            android:text="@string/delete" />
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <Button android:id="@+id/btnSell" style="@style/BigButton"
            android:layout_width="0dp" android:layout_weight="2"
            android:background="@drawable/btn_orange" android:text="@string/sell_this_now" />
    </LinearLayout>
</LinearLayout>
