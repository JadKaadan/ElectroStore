<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card_line"
    android:padding="15dp">

    <TextView android:id="@+id/name"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="17sp" android:textStyle="bold" android:textColor="@color/ink" />
    <TextView android:id="@+id/quantity"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="2dp" android:textSize="13sp" android:textColor="@color/ink_soft" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="13dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/profit_wholesale_cost" android:textSize="10sp"
                android:textStyle="bold" android:textColor="@color/ink_faint" />
            <TextView android:id="@+id/costUsd"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingTop="3dp" android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/ink" />
            <TextView android:id="@+id/costLbp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/ink_faint" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/profit_sold_for" android:textSize="10sp"
                android:textStyle="bold" android:textColor="@color/ink_faint" />
            <TextView android:id="@+id/soldUsd"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingTop="3dp" android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/ink" />
            <TextView android:id="@+id/soldLbp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/ink_faint" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="13dp" android:background="@drawable/tile_soft"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="9dp" android:paddingBottom="9dp">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/profit_product_profit"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/ink_soft" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/profitUsd"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" android:textStyle="bold" android:textColor="@color/green" />
            <TextView android:id="@+id/profitLbp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/ink_faint" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/missingCost"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="9dp" android:textSize="11sp" android:textColor="@color/amber"
        android:visibility="gone" />
</LinearLayout>
