<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_sheet"
    android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="10dp" android:paddingBottom="12dp">

    <View android:layout_width="42dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal" android:background="@drawable/grabber" />

    <TextView android:id="@+id/pinTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="12dp" android:gravity="center"
        android:textSize="20sp" android:textStyle="bold" android:textColor="@color/ink" />

    <TextView android:id="@+id/pinSub"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="4dp" android:gravity="center"
        android:textSize="13sp" android:textColor="@color/ink_soft" />

    <LinearLayout android:id="@+id/pinDots"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:orientation="horizontal"
        android:paddingTop="16dp" android:paddingBottom="8dp" />

    <TextView android:id="@+id/pinError"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:visibility="gone"
        android:textSize="14sp" android:textStyle="bold" android:textColor="@color/red" />

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/line" android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout android:id="@+id/pinGrid"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Button android:id="@+id/pinCancel" style="@style/SheetButton"
        android:layout_marginTop="8dp" android:background="@drawable/btn_outline"
        android:textColor="@color/ink" android:text="@string/cancel" />
</LinearLayout>
