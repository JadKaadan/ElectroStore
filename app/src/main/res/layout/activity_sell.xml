<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/hdr_orange" android:paddingStart="8dp"
        android:paddingEnd="20dp" android:paddingTop="22dp" android:paddingBottom="20dp">
        <ImageView android:id="@+id/back" android:tint="@color/ink" android:layout_width="44dp" android:layout_height="44dp"
            android:padding="10dp" android:background="@drawable/circle_soft"
            android:src="@drawable/ic_back" android:layout_centerVertical="true" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_toEndOf="@id/back"
            android:layout_centerVertical="true" android:paddingStart="12dp">
            <TextView style="@style/HeaderTitle" android:text="@string/sell_short" />
            <TextView android:id="@+id/sub" style="@style/HeaderSub" />
        </LinearLayout>
    </RelativeLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_card" android:elevation="1dp" android:padding="14dp">
                <FrameLayout android:layout_width="66dp" android:layout_height="66dp">
                    <ImageView android:id="@+id/photo"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/bg_photo" android:scaleType="centerCrop"
                        android:clipToOutline="true" />
                    <ImageView android:id="@+id/photoPlaceholder"
                        android:layout_width="28dp" android:layout_height="28dp"
                        android:layout_gravity="center" android:src="@drawable/ic_box"
                        android:alpha="0.3" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:paddingStart="12dp">
                    <TextView android:id="@+id/name"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="19sp" android:textStyle="bold" android:textColor="@color/ink" />
                    <TextView android:id="@+id/stock"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textColor="@color/ink_faint"
                        android:paddingTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="22dp"
                android:text="@string/lbl_how_many_buying" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/qtyMinus"
                    android:layout_width="62dp" android:layout_height="62dp"
                    android:background="@drawable/btn_outline" android:padding="18dp"
                    android:src="@drawable/ic_minus" />
                <EditText android:id="@+id/fQty" style="@style/Field"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="62dp" android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp" android:gravity="center"
                    android:textSize="24sp" android:textStyle="bold"
                    android:inputType="number" android:singleLine="true" android:text="1" />
                <ImageView android:id="@+id/qtyPlus"
                    android:layout_width="62dp" android:layout_height="62dp"
                    android:background="@drawable/btn_outline" android:padding="18dp"
                    android:src="@drawable/ic_plus" />
            </LinearLayout>

            <TextView style="@style/Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="22dp"
                android:text="@string/lbl_price_each" />
            <LinearLayout android:id="@+id/priceChoices"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingBottom="10dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <EditText android:id="@+id/fPrice" style="@style/Field"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="62dp" android:textSize="21sp" android:textStyle="bold"
                    android:inputType="numberDecimal" android:singleLine="true" />
                <TextView android:id="@+id/curUsd"
                    android:layout_width="wrap_content" android:layout_height="46dp"
                    android:layout_marginStart="10dp" android:gravity="center"
                    android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:background="@drawable/chip_on" android:text="$"
                    android:textStyle="bold" android:textSize="16sp" android:textColor="@color/white" />
                <TextView android:id="@+id/curLbp"
                    android:layout_width="wrap_content" android:layout_height="46dp"
                    android:layout_marginStart="8dp" android:gravity="center"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:background="@drawable/chip" android:text="@string/lbp_suffix"
                    android:textStyle="bold" android:textSize="15sp" android:textColor="@color/ink_soft" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card"
                android:elevation="1dp" android:padding="18dp" android:layout_marginTop="22dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/customer_pays" android:textSize="12sp"
                    android:textStyle="bold" android:textColor="@color/ink_faint" />
                <TextView android:id="@+id/totalUsd"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="36sp" android:textStyle="bold" android:textColor="@color/orange" />
                <TextView android:id="@+id/totalLbp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="16sp" android:textColor="@color/ink_soft" />
                <TextView android:id="@+id/profitLine"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/pill_green" android:padding="12dp"
                    android:layout_marginTop="14dp" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="@color/green" />
            </LinearLayout>

            <Space android:layout_width="match_parent" android:layout_height="18dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/card" android:elevation="8dp" android:padding="14dp">
        <Button android:id="@+id/btnSell" style="@style/BigButton"
            android:background="@drawable/btn_orange" android:text="@string/confirm_sale" />
    </LinearLayout>
</LinearLayout>
