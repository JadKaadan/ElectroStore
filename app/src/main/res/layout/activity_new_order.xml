<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/hdr_pink" android:paddingStart="8dp"
        android:paddingEnd="20dp" android:paddingTop="22dp" android:paddingBottom="20dp">
        <ImageView android:id="@+id/back" android:tint="@color/ink" android:layout_width="44dp" android:layout_height="44dp"
            android:padding="10dp" android:background="@drawable/circle_soft"
            android:src="@drawable/ic_back" android:layout_centerVertical="true" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_toEndOf="@id/back"
            android:layout_centerVertical="true" android:paddingStart="12dp">
            <TextView style="@style/HeaderTitle" android:text="@string/new_order_title" />
            <TextView android:id="@+id/receiptNo" style="@style/HeaderSub" />
        </LinearLayout>
    </RelativeLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView style="@style/Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/lbl_customer" />
            <EditText android:id="@+id/fCustomer" style="@style/Field"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/hint_customer"
                android:inputType="textCapWords" android:singleLine="true" />

            <TextView style="@style/Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="16dp"
                android:text="@string/lbl_phone" />
            <EditText android:id="@+id/fPhone" style="@style/Field"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="03 000 000" android:inputType="phone" android:singleLine="true" />

            <TextView style="@style/Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="22dp"
                android:text="@string/lbl_ordering" />

            <LinearLayout android:id="@+id/lines"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView android:id="@+id/noLines"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_photo_dash" android:padding="22dp"
                android:gravity="center" android:textSize="15sp" android:textColor="@color/ink_faint"
                android:text="@string/nothing_added" />

            <Button android:id="@+id/btnAddItem" style="@style/BigButton"
                android:layout_marginTop="10dp" android:layout_height="52dp"
                android:background="@drawable/btn_outline" android:textColor="@color/pink"
                android:text="@string/add_a_product" />

            <TextView style="@style/Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="22dp"
                android:text="@string/lbl_deposit" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <EditText android:id="@+id/fPaid" style="@style/Field"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:hint="0"
                    android:inputType="numberDecimal" android:singleLine="true" />
                <TextView android:id="@+id/curUsd"
                    android:layout_width="wrap_content" android:layout_height="46dp"
                    android:layout_marginStart="10dp" android:gravity="center"
                    android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:background="@drawable/chip_on" android:text="$"
                    android:textStyle="bold" android:textSize="16sp" android:textColor="@color/white" />
                <TextView android:id="@+id/curLbp"
                    android:layout_width="wrap_content" android:layout_height="46dp"
                    android:layout_marginStart="8dp" android:gravity="center"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:background="@drawable/chip" android:text="@string/lbp_suffix"
                    android:textStyle="bold" android:textSize="15sp" android:textColor="@color/ink_soft" />
            </LinearLayout>

            <TextView style="@style/Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="16dp"
                android:text="@string/lbl_note" />
            <EditText android:id="@+id/fNote" style="@style/Field"
                android:layout_width="match_parent" android:layout_height="90dp"
                android:hint="@string/hint_note" android:gravity="top|start"
                android:paddingTop="14dp" android:inputType="textMultiLine|textCapSentences" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card"
                android:elevation="1dp" android:padding="18dp" android:layout_marginTop="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/order_total" android:textSize="12sp"
                    android:textStyle="bold" android:textColor="@color/ink_faint" />
                <TextView android:id="@+id/totalUsd"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="34sp" android:textStyle="bold" android:textColor="@color/pink" />
                <TextView android:id="@+id/totalLbp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textColor="@color/ink_soft" />
                <TextView android:id="@+id/balance"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/pill_pink" android:padding="12dp"
                    android:layout_marginTop="14dp" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="@color/pink" />
            </LinearLayout>

            <Space android:layout_width="match_parent" android:layout_height="18dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/card" android:elevation="8dp" android:padding="14dp">
        <Button android:id="@+id/btnSave" style="@style/BigButton"
            android:background="@drawable/btn_pink" android:text="@string/save_show_receipt" />
    </LinearLayout>
</LinearLayout>
