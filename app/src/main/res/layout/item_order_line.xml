<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/bg_card_line" android:layout_marginBottom="8dp"
    android:padding="12dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:paddingEnd="8dp">
        <TextView android:id="@+id/name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink"
            android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/detail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="@color/ink_faint" />
    </LinearLayout>

    <TextView android:id="@+id/total"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" />

    <ImageView android:id="@+id/del" android:layout_width="36dp" android:layout_height="36dp"
        android:layout_marginStart="6dp" android:padding="10dp"
        android:src="@drawable/ic_close" android:alpha="0.4" />
</LinearLayout>
