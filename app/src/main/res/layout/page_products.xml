<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <RelativeLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/hdr_brand"
        android:paddingStart="8dp" android:paddingEnd="20dp"
        android:paddingTop="22dp" android:paddingBottom="20dp">

        <ImageView android:id="@+id/btnMenu"
            android:layout_width="46dp" android:layout_height="46dp"
            android:layout_centerVertical="true" android:padding="11dp"
            android:background="@drawable/circle_soft" android:tint="@color/ink"
            android:src="@drawable/ic_menu" android:contentDescription="@string/menu_calendar" />

        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_toEndOf="@id/btnMenu"
            android:layout_centerVertical="true" android:paddingStart="12dp">
            <TextView style="@style/HeaderTitle" android:text="@string/products_title" />
            <TextView android:id="@+id/subCount" style="@style/HeaderSub" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_field"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="14dp" android:paddingStart="14dp" android:paddingEnd="8dp">

        <ImageView android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_search" />

        <EditText android:id="@+id/search"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
            android:background="@null" android:hint="@string/search_product"
            android:paddingStart="10dp" android:paddingEnd="4dp"
            android:singleLine="true" android:inputType="text"
            android:textSize="17sp" android:textColor="@color/ink"
            android:textColorHint="@color/ink_faint" />

        <ImageView android:id="@+id/clearSearch"
            android:layout_width="34dp" android:layout_height="34dp"
            android:padding="8dp" android:visibility="gone"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <ScrollView android:id="@+id/scroll"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="20dp">

            <TextView android:id="@+id/catLabel" style="@style/Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="20dp" android:paddingTop="18dp"
                android:text="@string/categories_label" />

            <HorizontalScrollView android:id="@+id/catScroll"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:scrollbars="none" android:clipToPadding="false"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <LinearLayout android:id="@+id/catStrip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout android:id="@+id/sections"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingTop="6dp" />

            <LinearLayout android:id="@+id/empty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:visibility="gone" android:padding="40dp">
                <ImageView android:layout_width="72dp" android:layout_height="72dp"
                    android:src="@drawable/ic_box" android:alpha="0.25" />
                <TextView android:id="@+id/emptyText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingTop="14dp" android:textSize="17sp"
                    android:textColor="@color/ink_soft" android:gravity="center" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
