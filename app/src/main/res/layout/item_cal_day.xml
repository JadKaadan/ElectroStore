<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="46dp"
    android:layout_weight="1" android:clickable="true" android:focusable="true"
    android:background="?android:attr/selectableItemBackgroundBorderless">

    <View android:id="@+id/bubble"
        android:layout_width="38dp" android:layout_height="38dp"
        android:layout_gravity="center_horizontal|top" android:layout_marginTop="1dp" />

    <TextView android:id="@+id/num"
        android:layout_width="38dp" android:layout_height="38dp"
        android:layout_gravity="center_horizontal|top" android:layout_marginTop="1dp"
        android:gravity="center" android:textSize="15sp" android:textColor="@color/ink" />

    <View android:id="@+id/dot"
        android:layout_width="5dp" android:layout_height="5dp"
        android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="3dp"
        android:background="@drawable/cal_selected" android:visibility="invisible" />
</FrameLayout>
